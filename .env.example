# Copy this file to ".env" and fill in your own values

# SQL Server connection. For Vercel, use a reachable Azure SQL server.
# For SQL Express locally, use DB_SERVER=localhost\\SQLEXPRESS.
DB_SERVER=your-sql-server.database.windows.net
DB_PORT=1433
DB_USER=your_sql_username
DB_PASSWORD=your_sql_password
DB_NAME=devinda_enterprises
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# App settings
PORT=3000
SESSION_SECRET=replace_with_a_long_random_secret

# Company details shown on invoices
COMPANY_NAME=Devinda Enterprises (PVT) LTD
