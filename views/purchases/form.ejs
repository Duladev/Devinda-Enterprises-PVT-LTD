<%- include('../partials/header', { title: 'New Purchase' }) %>

<h4 class="mb-3">New Purchase (Stock In)</h4>

<div class="card p-4">
  <form action="/purchases" method="POST">
    <div class="row mb-3">
      <div class="col-md-4">
        <label class="form-label">Seller</label>
        <select name="seller_id" class="form-select">
          <option value>-- Walk-in / Unknown --</option>
          <% sellers.forEach(s => { %>
          <option value="<%= s.id %>"><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Purchase Date *</label>
        <input type="date" name="purchase_date" class="form-control"
          value="<%= today %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Discount Amount</label>
        <input type="number" step="0.01" min="0" name="discount_amount"
          id="discountAmountInput" class="form-control" value="0">
      </div>
      <div class="col-md-4">
        <label class="form-label">Paid Amount</label>
        <input type="number" step="0.01" min="0" name="paid_amount"
          class="form-control" value="0">
      </div>
      <div class="col-md-4">
        <label class="form-label">Payment Method</label>
        <select name="payment_method" class="form-select">
          <option>Cash</option><option>Bank
            Transfer</option><option>Card</option><option>Cheque</option><option>Credit</option>
        </select>
      </div>
    </div>

    <h6 class="mt-4 mb-2">Items</h6>
    <table class="table table-sm">
      <thead><tr><th>Product</th><th>Quantity</th><th>Unit Price</th><th
            class="text-end">Subtotal</th><th></th></tr></thead>
      <tbody id="itemsBody">
        <tr>
          <td>
            <select name="product_id"
              class="form-select form-select-sm product-select" required>
              <option value>-- Select product --</option>
              <% products.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %> (<%= p.unit %>)</option>
              <% }) %>
            </select>
          </td>
          <td><input type="number" step="0.01" min="0" name="quantity"
              class="form-control form-control-sm qty-input" required></td>
          <td><input type="number" step="0.01" min="0" name="unit_price"
              class="form-control form-control-sm price-input" required></td>
          <td class="subtotal-cell text-end">0.00</td>
          <td class="text-center"><i class="bi bi-x-circle item-row-remove"
              onclick="removeItemRow(this)"></i></td>
        </tr>
      </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline-secondary mb-3"
      onclick="addItemRow('itemsBody', productOptionsHtml)">
      <i class="bi bi-plus-lg"></i> Add Item
    </button>

    <div class="text-end mb-3">
      <h5>Total: LKR <span id="grandTotalDisplay">0.00</span></h5>
    </div>

    <div class="mb-3">
      <label class="form-label">Notes</label>
      <textarea name="notes" class="form-control" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Purchase</button>
    <a href="/purchases" class="btn btn-outline-secondary">Cancel</a>
  </form>
</div>

<script>
  const productOptionsHtml = `<% products.forEach(p => { %><option value="<%= p.id %>"><%= p.name %> (<%= p.unit %>)</option><% }) %>`;

  const discountInput = document.getElementById('discountAmountInput');

  function recalcTotal() {
    const subtotals = document.querySelectorAll('.subtotal-cell');
    let total = 0;
    subtotals.forEach(cell => { total += parseFloat(cell.textContent) || 0; });
    const discount = Math.max(parseFloat(discountInput?.value) || 0, 0);
    const netTotal = Math.max(total - discount, 0);
    const totalDisplay = document.getElementById('grandTotalDisplay');
    if (totalDisplay) totalDisplay.textContent = netTotal.toFixed(2);
  }

  if (discountInput) discountInput.addEventListener('input', recalcTotal);
</script>

<%- include('../partials/footer') %>
