<%- include('../partials/header', { title: cheque.id ? 'Edit Cheque' :
'Add Cheque' }) %>

<h4 class="mb-3"><%= cheque.id ? 'Edit Cheque' : 'Add Cheque' %></h4>

<div class="card p-4" style="max-width: 800px;">
    <form action="<%= action %>" method="<%= method %>">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Bank Account</label>
                <select name="account_id" class="form-select" required>
                    <option value>Select account</option>
                    <% accounts.forEach(account => { %>
                    <option value="<%= account.id %>"
                        <%=String(cheque.account_id) === String(account.id) ?
                        'selected' : '' %>><%= account.name %> - <%=
                        account.bank_name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Cheque Number</label>
                <input type="text" name="cheque_no" class="form-control"
                    value="<%= cheque.cheque_no || '' %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Payee</label>
                <input type="text" name="payee" class="form-control"
                    value="<%= cheque.payee || '' %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Amount</label>
                <input type="number" step="0.01" name="amount"
                    class="form-control" value="<%= cheque.amount || 0 %>"
                    required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Issue Date</label>
                <input type="date" name="issue_date" class="form-control"
                    value="<%= cheque.issue_date ? cheque.issue_date.toISOString ? cheque.issue_date.toISOString().slice(0,10) : cheque.issue_date.slice(0,10) : '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Due Date</label>
                <input type="date" name="due_date" class="form-control"
                    value="<%= cheque.due_date ? cheque.due_date.toISOString ? cheque.due_date.toISOString().slice(0,10) : cheque.due_date.slice(0,10) : '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Cheque Type</label>
                <select name="cheque_type" class="form-select">
                    <option value="Issued" <%=cheque.cheque_type === 'Issued' ?
                        'selected' : '' %>>Issued</option>
                    <option value="Received" <%=cheque.cheque_type ===
                        'Received' ? 'selected' : '' %>>Received</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="Pending" <%=cheque.status === 'Pending' ?
                        'selected' : '' %>>Pending</option>
                    <option value="Cleared" <%=cheque.status === 'Cleared' ?
                        'selected' : '' %>>Cleared</option>
                    <option value="Bounced" <%=cheque.status === 'Bounced' ?
                        'selected' : '' %>>Bounced</option>
                    <option value="Cancelled" <%=cheque.status === 'Cancelled' ?
                        'selected' : '' %>>Cancelled</option>
                    <option value="Deposited" <%=cheque.status === 'Deposited' ?
                        'selected' : '' %>>Deposited</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Bank Name</label>
                <input type="text" name="bank_name" class="form-control"
                    value="<%= cheque.bank_name || '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Branch</label>
                <input type="text" name="branch" class="form-control"
                    value="<%= cheque.branch || '' %>">
            </div>
            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea name="notes" class="form-control"
                    rows="3"><%= cheque.notes || '' %></textarea>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/cheques" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
