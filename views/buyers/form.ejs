<%- include('../partials/header', { title: buyer.id ? 'Edit Buyer' : 'Add Buyer'
}) %>

<h4 class="mb-3"><%= buyer.id ? 'Edit Buyer' : 'Add Buyer' %></h4>

<div class="card p-4" style="max-width:600px;">
  <form action="<%= action %>" method="<%= method %>">
    <div class="mb-3">
      <label class="form-label">Name *</label>
      <input type="text" name="name" class="form-control"
        value="<%= buyer.name || '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Phone</label>
      <input type="text" name="phone" class="form-control"
        value="<%= buyer.phone || '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" class="form-control"
        value="<%= buyer.email || '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Address</label>
      <input type="text" name="address" class="form-control"
        value="<%= buyer.address || '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">NIC</label>
      <input type="text" name="nic" class="form-control"
        value="<%= buyer.nic || '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Notes</label>
      <textarea name="notes" class="form-control"
        rows="2"><%= buyer.notes || '' %></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/buyers" class="btn btn-outline-secondary">Cancel</a>
  </form>
</div>

<%- include('../partials/footer') %>
