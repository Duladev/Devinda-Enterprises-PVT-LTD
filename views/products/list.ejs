<%- include('../partials/header', { title: 'Inventory' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4>Inventory</h4>
  <a href="/products/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Product</a>
</div>

<form class="mb-3" method="GET">
  <input type="text" name="q" value="<%= search %>" class="form-control" placeholder="Search product...">
</form>

<div class="card p-3">
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th>Name</th><th>Category</th><th>Stock</th><th>Reorder Level</th>
        <th>Cost Price</th><th>Selling Price</th><th></th>
      </tr>
    </thead>
    <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td><%= p.name %></td>
        <td><%= p.category %></td>
        <td>
          <% if (Number(p.current_stock) <= Number(p.reorder_level)) { %>
            <span class="badge badge-low-stock text-white"><%= p.current_stock %> <%= p.unit %></span>
          <% } else { %>
            <%= p.current_stock %> <%= p.unit %>
          <% } %>
        </td>
        <td><%= p.reorder_level %> <%= p.unit %></td>
        <td><%= Number(p.cost_price).toFixed(2) %></td>
        <td><%= Number(p.selling_price).toFixed(2) %></td>
        <td class="text-end">
          <a href="/products/<%= p.id %>/history" class="btn btn-sm btn-outline-info"><i class="bi bi-clock-history"></i></a>
          <a href="/products/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
          <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#adjustModal<%= p.id %>"><i class="bi bi-sliders"></i></button>
          <form action="/products/<%= p.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this product?');">
            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
          </form>
        </td>
      </tr>

      <!-- Stock adjustment modal -->
      <div class="modal fade" id="adjustModal<%= p.id %>" tabindex="-1">
        <div class="modal-dialog">
          <div class="modal-content">
            <form action="/products/<%= p.id %>/adjust" method="POST">
              <div class="modal-header">
                <h6 class="modal-title">Adjust Stock: <%= p.name %></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3">
                  <label class="form-label">Adjustment Type</label>
                  <select name="adjust_type" class="form-select">
                    <option value="add">Add Stock</option>
                    <option value="remove">Remove Stock (spoilage/loss)</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label">Quantity (<%= p.unit %>)</label>
                  <input type="number" step="0.01" min="0" name="quantity" class="form-control" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Reason (optional)</label>
                  <input type="text" name="reason" class="form-control">
                </div>
              </div>
              <div class="modal-footer">
                <button type="submit" class="btn btn-primary btn-sm">Save Adjustment</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
    <% if (products.length === 0) { %>
      <tr><td colspan="7" class="text-center text-muted">No products found.</td></tr>
    <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
