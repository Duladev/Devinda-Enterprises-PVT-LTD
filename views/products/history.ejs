<%- include('../partials/header', { title: product.name + ' - Stock History' }) %>

<h4 class="mb-3"><%= product.name %> - Stock History</h4>
<p class="text-muted">Current stock: <strong><%= product.current_stock %> <%= product.unit %></strong></p>

<div class="card p-3">
  <table class="table table-sm">
    <thead><tr><th>Date</th><th>Type</th><th>Quantity</th><th>Reference</th><th>Balance After</th></tr></thead>
    <tbody>
    <% transactions.forEach(t => { %>
      <tr>
        <td><%= new Date(t.created_at).toLocaleString('en-GB') %></td>
        <td>
          <span class="badge bg-<%= t.type === 'IN' ? 'success' : t.type === 'OUT' ? 'danger' : 'secondary' %>"><%= t.type %></span>
        </td>
        <td><%= t.quantity %> <%= product.unit %></td>
        <td><%= t.ref_type %><%= t.ref_id ? ' #' + t.ref_id : '' %></td>
        <td><%= t.balance_after %> <%= product.unit %></td>
      </tr>
    <% }) %>
    <% if (transactions.length === 0) { %>
      <tr><td colspan="5" class="text-center text-muted">No stock movements yet.</td></tr>
    <% } %>
    </tbody>
  </table>
</div>

<a href="/products" class="btn btn-outline-secondary mt-3">Back to Inventory</a>

<%- include('../partials/footer') %>
