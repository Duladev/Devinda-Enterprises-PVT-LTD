<%- include('../partials/header', { title: product.id ? 'Edit Product' : 'Add Product' }) %>

<h4 class="mb-3"><%= product.id ? 'Edit Product' : 'Add Product' %></h4>

<div class="card p-4" style="max-width:600px;">
  <form action="<%= action %>" method="<%= method %>">
    <div class="mb-3">
      <label class="form-label">Product Name *</label>
      <input type="text" name="name" class="form-control" value="<%= product.name || '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Category</label>
      <select name="category" class="form-select">
        <option value="Dry Fish" <%= product.category === 'Dry Fish' ? 'selected' : '' %>>Dry Fish</option>
        <option value="Fresh Fish" <%= product.category === 'Fresh Fish' ? 'selected' : '' %>>Fresh Fish</option>
        <option value="Other" <%= product.category === 'Other' ? 'selected' : '' %>>Other</option>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label">Unit</label>
      <input type="text" name="unit" class="form-control" value="<%= product.unit || 'kg' %>">
    </div>
    <% if (!product.id) { %>
    <div class="mb-3">
      <label class="form-label">Opening Stock</label>
      <input type="number" step="0.01" min="0" name="current_stock" class="form-control" value="<%= product.current_stock || 0 %>">
    </div>
    <% } %>
    <div class="mb-3">
      <label class="form-label">Reorder Level</label>
      <input type="number" step="0.01" min="0" name="reorder_level" class="form-control" value="<%= product.reorder_level || 0 %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Cost Price (per unit)</label>
      <input type="number" step="0.01" min="0" name="cost_price" class="form-control" value="<%= product.cost_price || 0 %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Selling Price (per unit)</label>
      <input type="number" step="0.01" min="0" name="selling_price" class="form-control" value="<%= product.selling_price || 0 %>">
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/products" class="btn btn-outline-secondary">Cancel</a>
  </form>
</div>

<%- include('../partials/footer') %>
