<%- include('../partials/header', { title: director.id ? 'Edit Director' :
'Add Director' }) %>

<h4 class="mb-3"><%= director.id ? 'Edit Director' : 'Add Director' %></h4>

<div class="card p-4" style="max-width:700px;">
    <form action="<%= action %>" method="<%= method %>">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Full Name *</label>
                <input type="text" name="name" class="form-control"
                    value="<%= director.name || '' %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Designation *</label>
                <input type="text" name="designation" class="form-control"
                    value="<%= director.designation || '' %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input type="text" name="phone" class="form-control"
                    value="<%= director.phone || '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control"
                    value="<%= director.email || '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">NIC</label>
                <input type="text" name="nic" class="form-control"
                    value="<%= director.nic || '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Appointment Date</label>
                <input type="date" name="appointment_date" class="form-control"
                    value="<%= director.appointment_date ? director.appointment_date.toISOString ? director.appointment_date.toISOString().slice(0,10) : director.appointment_date.slice(0,10) : '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="Active" <%=director.status === 'Active' ?
                        'selected' : '' %>>Active</option>
                    <option value="Inactive" <%=director.status === 'Inactive' ?
                        'selected' : '' %>>Inactive</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Address</label>
                <input type="text" name="address" class="form-control"
                    value="<%= director.address || '' %>">
            </div>
            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea name="notes" class="form-control"
                    rows="3"><%= director.notes || '' %></textarea>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/directors" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
