<%- include('../partials/header', { title: seller.name }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><%= seller.name %></h4>
  <a href="/sellers/<%= seller.id %>/edit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
</div>

<div class="card p-3 mb-4">
  <div class="row">
    <div class="col-md-4"><strong>Phone:</strong> <%= seller.phone || '-' %></div>
    <div class="col-md-4"><strong>Address:</strong> <%= seller.address || '-' %></div>
    <div class="col-md-4"><strong>NIC:</strong> <%= seller.nic || '-' %></div>
  </div>
</div>

<h6 class="mb-2">Purchase History</h6>
<div class="card p-3">
  <table class="table table-sm">
    <thead><tr><th>Purchase No</th><th>Date</th><th>Total</th><th>Paid</th><th>Balance</th><th></th></tr></thead>
    <tbody>
    <% purchases.forEach(p => { %>
      <tr>
        <td><%= p.purchase_no %></td>
        <td><%= new Date(p.purchase_date).toLocaleDateString('en-GB') %></td>
        <td><%= Number(p.total_amount).toFixed(2) %></td>
        <td><%= Number(p.paid_amount).toFixed(2) %></td>
        <td><%= Number(p.balance).toFixed(2) %></td>
        <td><a href="/purchases/<%= p.id %>" class="small">View</a></td>
      </tr>
    <% }) %>
    <% if (purchases.length === 0) { %>
      <tr><td colspan="6" class="text-center text-muted">No purchases yet.</td></tr>
    <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
