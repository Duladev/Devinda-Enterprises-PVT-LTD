<%- include('../partials/header', { title: 'Bank Facilities' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Bank Facilities</h4>
    <a href="/bank-facilities/new" class="btn btn-primary btn-sm"><i
            class="bi bi-plus-lg"></i> Add Facility</a>
</div>

<form class="mb-3" method="GET">
    <input type="text" name="q" value="<%= search %>" class="form-control"
        placeholder="Search by facility, provider, type or account...">
</form>

<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Facility</th>
                <th>Type</th>
                <th>Provider</th>
                <th>Outstanding</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% facilities.forEach(item => { %>
            <tr>
                <td><%= item.name || '-' %></td>
                <td><%= item.facility_type || '-' %></td>
                <td><%= item.provider || '-' %></td>
                <td>LKR <%= Number(item.outstanding_amount ||
                    0).toLocaleString('en-LK', { minimumFractionDigits: 2 })
                    %></td>
                <td><span class="badge bg-light text-dark"><%= item.status ||
                        'Active' %></span></td>
                <td class="text-end">
                    <a href="/bank-facilities/<%= item.id %>/edit"
                        class="btn btn-sm btn-outline-secondary"><i
                            class="bi bi-pencil"></i></a>
                    <form
                        action="/bank-facilities/<%= item.id %>?_method=DELETE"
                        method="POST" class="d-inline"
                        onsubmit="return confirm('Delete this facility?');">
                        <button class="btn btn-sm btn-outline-danger"><i
                                class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
            <% }) %>
            <% if (facilities.length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted">No bank
                    facilities found.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../partials/footer') %>
