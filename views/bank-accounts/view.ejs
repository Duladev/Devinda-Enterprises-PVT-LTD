<%- include('../partials/header', { title: account.name || 'Bank Account' }) %>

<%
const formatMoney = value => Number(value || 0).toLocaleString('en-LK', {
minimumFractionDigits: 2,
maximumFractionDigits: 2
});
const exportQuery = paginationQuery ? `?${paginationQuery}` : '';
%>

<div
    class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="text-muted small mb-1">BUSINESS BANKING · <%=
            account.account_type || 'Current' %> ACCOUNT</div>
        <h3 class="mb-1"><%= account.name || 'Current Account' %></h3>
        <div class="text-muted"><%= account.bank_name || '-' %> · <%=
            account.branch || 'Branch not specified' %> · Account ending <%=
            (account.account_number || '—').slice(-4) %></div>
    </div>
    <div class="d-flex gap-2">
        <a href="/bank-accounts" class="btn btn-outline-secondary"><i
                class="bi bi-arrow-left me-1"></i>Accounts</a>
        <a href="/bank-accounts/<%= account.id %>/edit"
            class="btn btn-outline-primary"><i
                class="bi bi-pencil me-1"></i>Edit account</a>
    </div>
</div>

<% if (error) { %>
<div class="alert alert-danger" role="alert"><i
        class="bi bi-exclamation-circle me-2"></i><%= error %></div>
<% } %>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div><div class="text-muted small">Available balance</div><div
                        class="fs-4 fw-bold mt-2">LKR <%=
                        formatMoney(account.current_balance) %></div></div>
                <span class="badge text-bg-primary"><i
                        class="bi bi-bank"></i></span>
            </div>
            <div class="small text-muted mt-2">Opening balance LKR <%=
                formatMoney(account.opening_balance) %></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 h-100">
            <div class="text-muted small">Deposits · filtered period</div>
            <div class="fs-4 fw-bold text-success mt-2">LKR <%=
                formatMoney(summary.totalDeposits) %></div>
            <div class="small text-muted mt-2">Money received into this
                account</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 h-100">
            <div class="text-muted small">Payments · filtered period</div>
            <div class="fs-4 fw-bold text-danger mt-2">LKR <%=
                formatMoney(summary.totalPayments) %></div>
            <div class="small text-muted mt-2">Money paid out of this
                account</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 h-100">
            <div class="text-muted small">Net cashflow · filtered period</div>
            <div
                class="fs-4 fw-bold mt-2 <%= summary.netCashflow >= 0 ? 'text-success' : 'text-danger' %>"><%=
                summary.netCashflow >= 0 ? '+' : '-' %> LKR <%=
                formatMoney(Math.abs(summary.netCashflow)) %></div>
            <div class="small text-muted mt-2"><%= summary.totalTransactions %>
                ledger entries</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card p-4">
            <div
                class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="mb-1">Record a transaction</h5>
                    <div class="small text-muted">Log business receipts,
                        supplier payments, expenses, and bank charges.</div>
                </div>
                <span class="badge rounded-pill text-bg-light border">LKR · Sri
                    Lankan Rupees</span>
            </div>
            <form method="POST" enctype="multipart/form-data"
                action="/bank-accounts/<%= account.id %>/transactions">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label"
                            for="transaction-date">Date</label>
                        <input id="transaction-date" type="date"
                            name="transaction_date" class="form-control"
                            value="<%= new Date().toISOString().slice(0,10) %>"
                            required>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label"
                            for="transaction-type">Transaction</label>
                        <select id="transaction-type" name="type"
                            class="form-select" required>
                            <option value="DEPOSIT">Money in · Deposit</option>
                            <option value="WITHDRAWAL">Money out ·
                                Payment</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label"
                            for="transaction-category">Category</label>
                        <select id="transaction-category" name="category"
                            class="form-select" required>
                            <% transactionCategories.forEach(category => { %>
                            <option value="<%= category %>"><%= category
                                %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label"
                            for="transaction-payment-method">Payment
                            method</label>
                        <select id="transaction-payment-method"
                            name="payment_method" class="form-select" required>
                            <option value="Cash">Cash</option>
                            <option value="Bank Transfer">Bank transfer</option>
                            <option value="Cheque">Cheque</option>
                            <option value="Card">Card</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label"
                            for="transaction-amount">Amount (LKR)</label>
                        <input id="transaction-amount" type="number" step="0.01"
                            min="0.01" max="999999999999.99" name="amount"
                            class="form-control" placeholder="0.00" required>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label"
                            for="transaction-reference">Reference</label>
                        <input id="transaction-reference" type="text"
                            maxlength="100" name="reference_no"
                            class="form-control"
                            placeholder="Invoice / receipt no.">
                    </div>
                    <div class="col-md-8 col-lg-2">
                        <label class="form-label"
                            for="transaction-description">Description</label>
                        <input id="transaction-description" type="text"
                            maxlength="255" name="description"
                            class="form-control" placeholder="Business purpose">
                    </div>
                    <div id="transfer-details" class="row g-3 mt-0 d-none">
                        <div class="col-sm-6 col-lg-3">
                            <label class="form-label"
                                for="transfer-bank-name">Destination
                                bank</label>
                            <input id="transfer-bank-name" type="text"
                                maxlength="150" name="transfer_bank_name"
                                class="form-control conditional-payment-field"
                                autocomplete="off">
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="form-label"
                                for="transfer-account-name">Account name</label>
                            <input id="transfer-account-name" type="text"
                                maxlength="150" name="transfer_account_name"
                                class="form-control conditional-payment-field"
                                autocomplete="off">
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="form-label"
                                for="transfer-account-number">Account
                                number</label>
                            <input id="transfer-account-number" type="text"
                                maxlength="100" name="transfer_account_number"
                                class="form-control conditional-payment-field"
                                autocomplete="off">
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="form-label"
                                for="transfer-branch">Branch</label>
                            <input id="transfer-branch" type="text"
                                maxlength="150" name="transfer_branch"
                                class="form-control" autocomplete="off">
                        </div>
                    </div>
                    <div id="cheque-details" class="row g-3 mt-0 d-none">
                        <div class="col-sm-6 col-lg-3">
                            <label class="form-label" for="cheque-number">Cheque
                                number</label>
                            <input id="cheque-number" type="text" maxlength="50"
                                name="cheque_number"
                                class="form-control conditional-payment-field"
                                autocomplete="off">
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="form-label"
                                for="cheque-bank-name">Bank name</label>
                            <input id="cheque-bank-name" type="text"
                                maxlength="150" name="transfer_bank_name"
                                class="form-control conditional-payment-field"
                                autocomplete="off">
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="form-label" for="cheque-date">Cheque
                                date</label>
                            <input id="cheque-date" type="date"
                                name="cheque_date"
                                class="form-control conditional-payment-field">
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="form-label" for="cheque-payee">Payee /
                                payer</label>
                            <input id="cheque-payee" type="text" maxlength="150"
                                name="cheque_payee"
                                class="form-control conditional-payment-field"
                                autocomplete="off">
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label"
                            for="transaction-evidence">Evidence <span
                                class="text-muted fw-normal">(PDF or image, max
                                10 MB)</span></label>
                        <input id="transaction-evidence" type="file"
                            name="evidence" class="form-control"
                            accept="application/pdf,image/jpeg,image/png,image/webp,image/gif">
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button class="btn btn-primary px-4" type="submit"><i
                                class="bi bi-plus-circle me-1"></i>Save
                            transaction</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card p-4">
    <div
        class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h5 class="mb-1">Account ledger</h5>
            <div class="small text-muted">Search and review your account
                activity. Balances reflect recorded entries.</div>
        </div>
        <a href="/bank-accounts/<%= account.id %>/export.csv<%= exportQuery %>"
            class="btn btn-outline-primary">
            <i class="bi bi-download me-1"></i>Export statement
        </a>
    </div>

    <form method="GET" action="/bank-accounts/<%= account.id %>"
        class="row g-2 align-items-end mb-3">
        <div class="col-sm-6 col-lg-2">
            <label for="filter-from" class="form-label small">From</label>
            <input id="filter-from" type="date" name="from_date"
                value="<%= filters.from_date %>"
                class="form-control form-control-sm">
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="filter-to" class="form-label small">To</label>
            <input id="filter-to" type="date" name="to_date"
                value="<%= filters.to_date %>"
                class="form-control form-control-sm">
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="filter-type" class="form-label small">Flow</label>
            <select id="filter-type" name="type"
                class="form-select form-select-sm">
                <option value>All transactions</option>
                <option value="IN" <%=filters.type === 'IN' ? 'selected' : ''
                    %>>Deposits</option>
                <option value="OUT" <%=filters.type === 'OUT' ? 'selected' : ''
                    %>>Payments</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label for="filter-category"
                class="form-label small">Category</label>
            <select id="filter-category" name="category"
                class="form-select form-select-sm">
                <option value>All categories</option>
                <% transactionCategories.forEach(category => { %>
                <option value="<%= category %>" <%=filters.category === category
                    ? 'selected' : '' %>><%= category %></option>
                <% }) %>
            </select>
        </div>
        <div class="col-sm-8 col-lg-2">
            <label for="filter-search" class="form-label small">Reference or
                description</label>
            <input id="filter-search" type="search" name="q"
                value="<%= filters.q %>" maxlength="100"
                class="form-control form-control-sm"
                placeholder="Search ledger">
        </div>
        <div class="col-sm-4 col-lg-2 d-flex gap-2">
            <button type="submit"
                class="btn btn-primary btn-sm flex-grow-1">Apply</button>
            <a href="/bank-accounts/<%= account.id %>"
                class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th><th>Transaction</th><th>Method /
                        details</th><th>Category</th><th>Reference</th><th>Description</th><th
                        class="text-end">Amount</th><th class="text-end">Balance
                        after</th><th>Evidence</th>
                </tr>
            </thead>
            <tbody>
                <% transactions.forEach(tx => { %>
                <tr>
                    <td class="text-nowrap"><%= new
                        Date(tx.transaction_date).toISOString().slice(0,10)
                        %></td>
                    <td><span
                            class="badge <%= tx.type === 'IN' ? 'text-bg-success' : 'text-bg-danger' %>"><%=
                            tx.type === 'IN' ? 'Deposit' : 'Payment'
                            %></span></td>
                    <td>
                        <div><%= tx.payment_method || 'Cash' %></div>
                        <% if (tx.payment_method === 'Bank Transfer' &&
                        tx.transfer_bank_name) { %>
                        <small class="text-muted"><%= tx.transfer_bank_name %> ·
                            <%= tx.transfer_account_name %> · <%=
                            tx.transfer_account_number %></small>
                        <% } else if (tx.payment_method === 'Cheque' &&
                        tx.cheque_number) { %>
                        <small class="text-muted"><%= tx.cheque_number %> · <%=
                            tx.transfer_bank_name %> · <%= tx.cheque_payee
                            %></small>
                        <small class="text-muted d-block"><%= tx.cheque_date ?
                            new Date(tx.cheque_date).toISOString().slice(0,10) :
                            '' %></small>
                        <% } %>
                    </td>
                    <td><%= tx.category || 'General' %></td>
                    <td><%= tx.reference_no || '—' %></td>
                    <td class="text-break"><%= tx.description || '—' %></td>
                    <td
                        class="text-end text-nowrap fw-semibold <%= tx.type === 'IN' ? 'text-success' : 'text-danger' %>"><%=
                        tx.type === 'IN' ? '+' : '−' %> LKR <%=
                        formatMoney(tx.amount) %></td>
                    <td class="text-end text-nowrap">LKR <%=
                        formatMoney(tx.balance_after) %></td>
                    <td><% if (tx.evidence_filename) { %><a
                            href="/bank-accounts/<%= account.id %>/transactions/<%= tx.id %>/evidence"
                            target="_blank" rel="noopener"
                            class="btn btn-sm btn-outline-secondary"
                            aria-label="View transaction evidence"><i
                                class="bi bi-paperclip"></i> View</a><% } else {
                        %><span class="text-muted">—</span><% } %></td>
                </tr>
                <% }) %>
                <% if (transactions.length === 0) { %>
                <tr><td colspan="9" class="text-center text-muted py-5"><i
                            class="bi bi-journal-text fs-3 d-block mb-2"></i>No
                        transactions match these filters.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (pageCount > 1) { %>
    <nav class="d-flex justify-content-between align-items-center mt-3"
        aria-label="Ledger pages">
        <span class="small text-muted">Page <%= filters.page %> of <%= pageCount
            %> · <%= summary.totalTransactions %> transactions</span>
        <div class="btn-group btn-group-sm">
            <% if (filters.page > 1) { %>
            <a class="btn btn-outline-secondary"
                href="/bank-accounts/<%= account.id %>?<%= paginationQuery ? `${paginationQuery}&` : '' %>page=<%= filters.page - 1 %>"><i
                    class="bi bi-chevron-left"></i> Previous</a>
            <% } %>
            <% if (filters.page < pageCount) { %>
            <a class="btn btn-outline-secondary"
                href="/bank-accounts/<%= account.id %>?<%= paginationQuery ? `${paginationQuery}&` : '' %>page=<%= filters.page + 1 %>">Next
                <i class="bi bi-chevron-right"></i></a>
            <% } %>
        </div>
    </nav>
    <% } %>
</div>

<script>
    const paymentMethodSelect = document.getElementById('transaction-payment-method');
    const transferDetails = document.getElementById('transfer-details');
    const chequeDetails = document.getElementById('cheque-details');

    function updatePaymentFields() {
        const method = paymentMethodSelect.value;
        transferDetails.classList.toggle('d-none', method !== 'Bank Transfer');
        chequeDetails.classList.toggle('d-none', method !== 'Cheque');
        transferDetails.querySelectorAll('.conditional-payment-field').forEach(field => {
            field.required = method === 'Bank Transfer';
            field.disabled = method !== 'Bank Transfer';
        });
        chequeDetails.querySelectorAll('.conditional-payment-field').forEach(field => {
            field.required = method === 'Cheque';
            field.disabled = method !== 'Cheque';
        });
    }

    paymentMethodSelect.addEventListener('change', updatePaymentFields);
    updatePaymentFields();
</script>

<%- include('../partials/footer') %>
