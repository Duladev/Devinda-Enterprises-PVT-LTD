<%- include('../partials/header', { title: 'Employees' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Employees</h4>
    <a href="/employees/new" class="btn btn-primary btn-sm"><i
            class="bi bi-plus-lg"></i> Add Employee</a>
</div>

<form class="mb-3" method="GET">
    <input type="text" name="q" value="<%= search %>" class="form-control"
        placeholder="Search by name, phone, email or NIC...">
</form>

<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead><tr><th>Name</th><th>Position</th><th>Phone</th><th>Status</th><th></th></tr></thead>
        <tbody>
            <% employees.forEach(e => { %>
            <tr>
                <td><a href="/employees/<%= e.id %>"><%= e.name %></a></td>
                <td><%= e.position || '-' %></td>
                <td><%= e.phone || '-' %></td>
                <td><span class="badge bg-light text-dark"><%= e.status ||
                        'Active' %></span></td>
                <td class="text-end">
                    <a href="/employees/<%= e.id %>/edit"
                        class="btn btn-sm btn-outline-secondary"><i
                            class="bi bi-pencil"></i></a>
                    <form action="/employees/<%= e.id %>?_method=DELETE"
                        method="POST" class="d-inline"
                        onsubmit="return confirm('Delete this employee?');">
                        <button class="btn btn-sm btn-outline-danger"><i
                                class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
            <% }) %>
            <% if (employees.length === 0) { %>
            <tr><td colspan="5" class="text-center text-muted">No employees
                    found.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../partials/footer') %>
