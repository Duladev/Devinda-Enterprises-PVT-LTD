<%- include('../partials/header', { title: shareholder.id ? 'Edit Shareholder' :
'Add Shareholder' }) %>

<h4 class="mb-3"><%= shareholder.id ? 'Edit Shareholder' : 'Add Shareholder'
    %></h4>

<div class="card p-4" style="max-width:700px;">
    <form action="<%= action %>" method="<%= method %>">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Full Name *</label>
                <input type="text" name="name" class="form-control"
                    value="<%= shareholder.name || '' %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Share Type</label>
                <select name="share_type" class="form-select">
                    <option value="Individual" <%=shareholder.share_type ===
                        'Individual' ? 'selected' : '' %>>Individual</option>
                    <option value="Company" <%=shareholder.share_type ===
                        'Company' ? 'selected' : '' %>>Company</option>
                    <option value="Trust" <%=shareholder.share_type === 'Trust'
                        ? 'selected' : '' %>>Trust</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Shares</label>
                <input type="number" step="0.01" name="shares"
                    class="form-control" value="<%= shareholder.shares || 0 %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Share Percentage (%)</label>
                <input type="number" step="0.01" name="share_percentage"
                    class="form-control"
                    value="<%= shareholder.share_percentage || 0 %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input type="text" name="phone" class="form-control"
                    value="<%= shareholder.phone || '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control"
                    value="<%= shareholder.email || '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">NIC</label>
                <input type="text" name="nic" class="form-control"
                    value="<%= shareholder.nic || '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="Active" <%=shareholder.status === 'Active' ?
                        'selected' : '' %>>Active</option>
                    <option value="Inactive" <%=shareholder.status ===
                        'Inactive' ? 'selected' : '' %>>Inactive</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Address</label>
                <input type="text" name="address" class="form-control"
                    value="<%= shareholder.address || '' %>">
            </div>
            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea name="notes" class="form-control"
                    rows="3"><%= shareholder.notes || '' %></textarea>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/shareholders" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
