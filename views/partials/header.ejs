<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%=
      companyName %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
      <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
          <img src="/images/logo.png" alt="Devinda Enterprises logo"
            class="brand-logo">
          <span class="fw-fullybold"><%= companyName %></span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
          data-bs-target="#navMenu">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
          <ul class="navbar-nav me-auto mb-4 mb-lg-0">
            <li class="nav-item"><a
                class="nav-link <%= currentPath === '/' ? 'active' : '' %>"
                href="/">Dashboard</a></li>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/sales') ? 'active' : '' %>"
                href="/sales">Sales</a></li>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/purchases') ? 'active' : '' %>"
                href="/purchases">Purchases</a></li>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/products') ? 'active' : '' %>"
                href="/products">Inventory</a></li>
            <% if (isSuperAdmin) { %>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/employees') ? 'active' : '' %>"
                href="/employees">Employees</a></li>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/directors') ? 'active' : '' %>"
                href="/directors">Directors</a></li>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/shareholders') ? 'active' : '' %>"
                href="/shareholders">Shareholders</a></li>
            <% } %>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/assets') ? 'active' : '' %>"
                href="/assets">Assets</a></li>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/bank-management') ? 'active' : '' %>"
                href="/bank-management">Bank Management</a></li>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/buyers') ? 'active' : '' %>"
                href="/buyers">Buyers</a></li>
            <li class="nav-item"><a
                class="nav-link <%= currentPath && currentPath.startsWith('/sellers') ? 'active' : '' %>"
                href="/sellers">Sellers</a></li>
          </ul>
          <% if (currentUser) { %>
          <form action="/logout" method="POST"
            class="d-flex align-items-center gap-2">
            <span class="text-light small">Hi, <%= currentUser %></span>
            <button class="btn btn-sm btn-outline-light"
              type="submit">Logout</button>
          </form>
          <% } %>
        </div>
      </div>
    </nav>
    <div class="container-fluid py-4 px-4">
